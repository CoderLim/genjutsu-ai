# ShipAny Next — environment variables
#
# Local development:
#   cp .env.example .env.development   # then fill in the values below
#
# Loader priority (scripts/with-env.ts + vite loadEnvFiles):
#   .env.{NODE_ENV}.local > .env.{NODE_ENV} > .env.local > .env
# So in dev, .env.development is picked up by both `pnpm dev` and the db scripts.
#
# Keep this file minimal: provider credentials (payments, OAuth, email,
# storage, AI, analytics) are configured in the admin panel → Settings and
# stored in the database (encrypted when CONFIG_ENCRYPTION_KEY is set).
# Env vars with the matching names still work as fallbacks — database values
# take precedence — but they don't need to live in this template.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
VITE_APP_URL=http://localhost:3000
VITE_APP_NAME=Genjutsu AI
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:data/local.db
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Extra origins allowed to call the auth API (comma-separated). A leading dot
# is a hostname-suffix wildcard, e.g. `.e2b.app` for cloud-sandbox previews.
AUTH_TRUSTED_ORIGINS=

# ---------------------------------------------------------------------------
# App (optional — sensible defaults exist in src/config/index.ts)
# ---------------------------------------------------------------------------
VITE_APP_DESCRIPTION=Genjutsu AI restyles products, outfits, objects and scenes in video while keeping the original motion.
VITE_APP_LOGO=/logo.webp
VITE_APP_SUPPORT_EMAIL=support@genjutsuai.net
VITE_DEFAULT_LOCALE=en
# Production site: https://genjutsuai.net — set VITE_APP_URL to that in
# .env.production / wrangler vars (keep localhost for local development).

# ---------------------------------------------------------------------------
# Payment — Waffo Pancake (optional; also configurable in Admin → Settings)
# ---------------------------------------------------------------------------
# Dashboard: https://pancake.waffo.ai/merchant/dashboard/integration
# Webhook URL: {APP_URL}/api/payment/notify/waffo
# New Store per product (do not reuse other apps' STO_*). Merchant can be shared.
# WAFFO_ENABLED=true
# DEFAULT_PAYMENT_PROVIDER=waffo
# WAFFO_MERCHANT_ID=MER_xxx
# WAFFO_PRIVATE_KEY=          # RSA PEM or raw base64; server-side only
# WAFFO_STORE_ID=STO_xxx
# WAFFO_ENVIRONMENT=test      # test | prod
# Map catalog IDs → Waffo product IDs:
# WAFFO_PRODUCT_IDS_MAPPING={"starter":"PROD_xxx","creator":"PROD_xxx","pro":"PROD_xxx","studio":"PROD_xxx"}

# ---------------------------------------------------------------------------
# Admin settings encryption (recommended)
# ---------------------------------------------------------------------------
# Encrypts secrets saved via admin Settings (AES-256-GCM) in the config table.
# Unset = plaintext storage. Once set, keep it stable — rotating or removing
# it orphans already-encrypted values (they fall back to env values).
# Generate with: openssl rand -base64 32
CONFIG_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (advanced / non-sqlite)
# ---------------------------------------------------------------------------
# DATABASE_PROVIDER options: sqlite | postgres | mysql | turso | d1
#   PostgreSQL: postgresql://user:pass@localhost:5432/dbname
#   MySQL:      mysql://user:pass@localhost:3306/dbname
#   Turso:      libsql://<db>.turso.io   (also set DATABASE_AUTH_TOKEN below)
# DATABASE_AUTH_TOKEN=                # Turso auth token (required for turso)
# DB_SCHEMA=public                    # Postgres schema
# DB_SINGLETON_ENABLED=false          # reuse a single connection (serverless)
# DB_MAX_CONNECTIONS=1

# ---------------------------------------------------------------------------
# Auth (optional — AUTH_URL defaults to VITE_APP_URL)
# ---------------------------------------------------------------------------
# AUTH_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Genjutsu safety (server-only)
# ---------------------------------------------------------------------------
# Optional env fallback. You can also set this in Admin -> Settings -> AI -> Fal.
# Used to reject reference images containing human faces before Higgsfield.
FAL_KEY=

# ---------------------------------------------------------------------------
# Hotel Lobby AI preset (optional)
# ---------------------------------------------------------------------------
# The default preset video is read from the configured R2 upload path at this
# object key. Upload the licensed MP4/MOV with Content-Type video/mp4 or
# video/quicktime. The clip must be 5–15 seconds and support byte-range reads.
# HOTEL_LOBBY_TEMPLATE_VIDEO_KEY=hotel-lobby/templates/default.mp4
#
# Optional real output used in the landing-page result showcase + VideoObject.
# Only set these after you have a genuine generated result and thumbnail.
# VITE_HOTEL_LOBBY_EXAMPLE_VIDEO_URL=
# VITE_HOTEL_LOBBY_EXAMPLE_THUMBNAIL_URL=
# VITE_HOTEL_LOBBY_EXAMPLE_UPLOAD_DATE=2026-10-06
# VITE_HOTEL_LOBBY_EXAMPLE_DURATION=PT5S

# ---------------------------------------------------------------------------
# AI Zombie Hug preset (optional)
# ---------------------------------------------------------------------------
# Shared motion-transfer source clip under the R2 upload path. Upload
# public/videos/zombie-hug-tpl.mp4 as video/mp4. Local Node can seed this key
# from the public file when missing; Cloudflare Workers require a pre-upload.
# ZOMBIE_HUG_TEMPLATE_VIDEO_KEY=genjutsu/templates/zombie-hug.mp4

# ---------------------------------------------------------------------------
# Higgsfield Genjutsu (server-only)
# ---------------------------------------------------------------------------
# Copy the complete API key from https://open.higgsfield.ai/api-keys.
# Keep it server-side; never use a VITE_ prefix.
HF_API_KEY=
# Optional overrides. The Object Swap provider path below matches Higgsfield's
# currently published workflow docs, including the "higgsfiled" spelling.
# HF_API_BASE_URL=https://api.higgsfield.ai
# HIGGSFIELD_GENJUTSU_MOTION_MODEL=higgsfield/genjutsu/motion-transfer/v1.0
# HIGGSFIELD_GENJUTSU_OBJECT_SWAP_MODEL=higgsfield/genjutsu/object-swap/v1.0
#
# Workflow provider routing. Defaults stay on Higgsfield unless explicitly
# enabled. Seedance uses the Fal key configured above.
# GENJUTSU_MOTION_PROVIDER=seedance
# GENJUTSU_OBJECT_SWAP_PROVIDER=seedance
# SEEDANCE_GENJUTSU_MODEL=bytedance/seedance-2.5/us/reference-to-video
# SEEDANCE_GENJUTSU_GENERATE_AUDIO=true
#
# Volcengine Ark Seedance 2.5. Use provider=seedance-volcengine to route NEW
# jobs to Ark; existing provider=seedance jobs continue polling fal.
# ARK_API_KEY=
# ARK_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# SEEDANCE_VOLCENGINE_MODEL=doubao-seedance-2-5-260628
# SEEDANCE_VOLCENGINE_VIDEO_INPUT_RATE_CNY_PER_MILLION_TOKENS=42
# SEEDANCE_VOLCENGINE_CNY_PER_USD=7
# GENJUTSU_MOTION_PROVIDER=seedance-volcengine
# GENJUTSU_OBJECT_SWAP_PROVIDER=seedance-volcengine
#
# Local E2E/manual-flow mode only. Never enable in production.
# Uploads stay in process memory; paid generation/submit (Higgsfield or Fal
# Seedance) is mocked and the result is the source video. Face-detect via Fal
# is skipped. Seedance cost uses list rates (no Fal queue). Higgsfield
# /estimate still hits HF when provider is higgsfield (needs HF_API_KEY).
# Site credits still reserve/settle normally — no auto-grant.
# GENJUTSU_E2E_MOCK=false
